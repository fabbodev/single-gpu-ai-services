# Host binding. Production may set these to a trusted Tailscale address.
GATEWAY_BIND_ADDRESS=127.0.0.1
MCP_BIND_ADDRESS=127.0.0.1

# Host directory containing runtime secrets. Do not commit its contents.
AI_SECRETS_DIR=/etc/ai-services/secrets

# Optional image override for the TTS engine.
# The referenced image must preserve the entrypoint/path contract described in docs/INSTALL.md.
# TTS_IMAGE=your-registry/your-coqui-image:tag

# Control-plane admission and upload limits.
AI_MAX_INFLIGHT_REQUESTS=8
AI_MAX_OCR_UPLOAD_BYTES=33554432
AI_MAX_STT_UPLOAD_BYTES=134217728
MCP_MAX_FILE_BYTES=67108864
